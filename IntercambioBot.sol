pragma solidity 0.8.22;

/*  IntercambioBot — swap directo por PancakeSwap V3 con tarifa fija en BNB al owner.
 *  Independiente del contrato del bot: no comparte storage, no puede romper nada.
 *
 *  Convención de monedas (la usa la web):
 *    - address(0)  = BNB NATIVO
 *    - cualquier otra dirección = ese ERC20 (incluido WBNB si alguna vez se usa como token)
 *
 *  Reglas de pago:
 *    - Entra BNB nativo (tokenIn == address(0)): msg.value = tarifaSwap + monto a intercambiar.
 *    - Entra ERC20 (tokenIn != address(0)): aprobar antes; msg.value = tarifaSwap.
 *    - Sale BNB nativo (tokenOut == address(0)): recibes BNB desenvuelto.
 */

interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

interface IWBNB {
    function deposit() external payable;
    function withdraw(uint256) external;
}

interface ISwapRouter {
    struct ExactInputSingleParams {
        address tokenIn;
        address tokenOut;
        uint24  fee;
        address recipient;
        uint256 deadline;
        uint256 amountIn;
        uint256 amountOutMinimum;
        uint160 sqrtPriceLimitX96;
    }
    function exactInputSingle(ExactInputSingleParams calldata params)
        external payable returns (uint256 amountOut);
}

contract IntercambioBot {
    address public owner;
    uint256 public tarifaSwap; // en wei de BNB; se manda al owner en CADA swap

    ISwapRouter public constant ROUTER = ISwapRouter(0x1b81D678ffb9C0263b24A97847620C99d213eB14);
    address     public constant WBNB   = 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c;

    uint256 private _lock = 1;

    event Swapeado(address indexed usuario, address tokenIn, address tokenOut, uint256 entra, uint256 sale);
    event TarifaCambiada(uint256 nueva);

    modifier onlyOwner() { require(msg.sender == owner, "solo owner"); _; }
    modifier noReentrada() { require(_lock == 1, "reentrada"); _lock = 2; _; _lock = 1; }

    constructor(uint256 _tarifaSwap) {
        owner = msg.sender;
        tarifaSwap = _tarifaSwap;
    }

    function setTarifaSwap(uint256 nueva) external onlyOwner {
        tarifaSwap = nueva;
        emit TarifaCambiada(nueva);
    }

    function transferOwnership(address nuevo) external onlyOwner {
        require(nuevo != address(0), "cero");
        owner = nuevo;
    }

    /// Intercambia tokenIn -> tokenOut por PancakeSwap V3 (un solo pool, feeTier `fee`).
    /// minOut lo calcula la web con QuoterV2 (menos slippage).
    function swap(
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        uint256 minOut,
        uint24  fee
    ) external payable noReentrada returns (uint256 amountOut) {
        require(msg.value >= tarifaSwap, "falta tarifa");
        require(tokenIn != tokenOut, "mismo token");

        // 1) Cobrar la tarifa al owner
        if (tarifaSwap > 0) {
            (bool paid, ) = payable(owner).call{value: tarifaSwap}("");
            require(paid, "tarifa fallo");
        }

        bool entraBNB = (tokenIn  == address(0));
        bool saleBNB  = (tokenOut == address(0));

        address rIn  = entraBNB ? WBNB : tokenIn;
        address rOut = saleBNB  ? WBNB : tokenOut;

        // 2) Preparar el tokenIn dentro de este contrato
        if (entraBNB) {
            amountIn = msg.value - tarifaSwap;         // todo el BNB restante se intercambia
            require(amountIn > 0, "monto 0");
            IWBNB(WBNB).deposit{value: amountIn}();     // BNB -> WBNB
        } else {
            require(amountIn > 0, "monto 0");
            _safeTransferFrom(tokenIn, msg.sender, address(this), amountIn);
        }

        // 3) Aprobar router y ejecutar
        _safeApprove(rIn, address(ROUTER), amountIn);

        address destino = saleBNB ? address(this) : msg.sender; // si sale BNB, primero llega WBNB aquí
        amountOut = ROUTER.exactInputSingle(ISwapRouter.ExactInputSingleParams({
            tokenIn: rIn,
            tokenOut: rOut,
            fee: fee,
            recipient: destino,
            deadline: block.timestamp + 300,
            amountIn: amountIn,
            amountOutMinimum: minOut,
            sqrtPriceLimitX96: 0
        }));

        // 4) Si sale BNB: desenvolver y mandar nativo al usuario
        if (saleBNB) {
            IWBNB(WBNB).withdraw(amountOut);
            (bool sent, ) = payable(msg.sender).call{value: amountOut}("");
            require(sent, "envio fallo");
        }

        emit Swapeado(msg.sender, tokenIn, tokenOut, amountIn, amountOut);
    }

    // --- rescates de seguridad (por si algo queda atascado) ---
    function rescatarToken(address token, uint256 amount) external onlyOwner {
        _safeTransfer(token, owner, amount);
    }
    function rescatarBNB(uint256 amount) external onlyOwner {
        (bool ok, ) = payable(owner).call{value: amount}("");
        require(ok, "fallo");
    }

    // --- helpers ERC20 tolerantes (algunos BEP20 no devuelven bool) ---
    function _safeApprove(address token, address spender, uint256 amount) private {
        (bool s0, ) = token.call(abi.encodeWithSelector(IERC20.approve.selector, spender, 0));
        s0; // reset previo para tokens tipo USDT; ignoramos el resultado
        (bool ok, bytes memory data) = token.call(abi.encodeWithSelector(IERC20.approve.selector, spender, amount));
        require(ok && (data.length == 0 || abi.decode(data, (bool))), "approve fallo");
    }
    function _safeTransfer(address token, address to, uint256 amount) private {
        (bool ok, bytes memory data) = token.call(abi.encodeWithSelector(IERC20.transfer.selector, to, amount));
        require(ok && (data.length == 0 || abi.decode(data, (bool))), "transfer fallo");
    }
    function _safeTransferFrom(address token, address from, address to, uint256 amount) private {
        (bool ok, bytes memory data) = token.call(abi.encodeWithSelector(IERC20.transferFrom.selector, from, to, amount));
        require(ok && (data.length == 0 || abi.decode(data, (bool))), "transferFrom fallo");
    }

    receive() external payable {} // recibe BNB del unwrap de WBNB
}



